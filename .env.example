# Optional. Spotify "now playing" card in the hero (server side only, set these in Vercel).
# Get the refresh token once with: node scripts/spotify-token.mjs
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=

# Visitor counts (footer total + globe). Server side only, set in Vercel.
# Vercel → Storage → add Upstash Redis (free) to this project; it sets these automatically (KV_REST_API_URL /
# KV_REST_API_TOKEN also work). Only production deploys record visits.
# Optional: VISITOR_SALT=any-random-string (salt for the hashed IPs used to count each visitor once).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
