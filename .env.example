# Optional. Counter used for the profile-visits number in the footer (https://abacus.jasoncameron.dev).
# Defaults are fine; set these to use your own namespace.
# VITE_VISITS_NS=your-namespace
# VITE_VISITS_KEY=visits

# Optional. Spotify "now playing" card in the hero (server side only, set these in Vercel).
# Get the refresh token once with: node scripts/spotify-token.mjs
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=

# Optional. Visitors-by-country globe (footer → "profile visits"). Server side only, set in Vercel.
# Vercel → Storage → add Upstash Redis (free) to this project; it sets these automatically (KV_REST_API_URL /
# KV_REST_API_TOKEN also work). Only production deploys record visits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
